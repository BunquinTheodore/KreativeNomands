# Kreativ Nomads - environment variables
# Copy to .env.local for development; set the same names in your host (e.g. Vercel project settings).
# Never commit real values and never prefix these with NEXT_PUBLIC_ (they must stay server-side).

# --- Contact form (POST /api/contact) -----------------------------------------
# Resend API key (https://resend.com/api-keys). Required to deliver contact messages.
RESEND_API_KEY=

# Inbox that receives website inquiries. Comma-separate several addresses if needed.
# Required. Without RESEND_API_KEY + CONTACT_TO_EMAIL the API answers 503 "not_configured"
# and the form offers a prefilled mailto: link instead (it never pretends the message was sent).
CONTACT_TO_EMAIL=contact@kreativnomads.com.ph

# Optional verified sender, e.g. "Kreativ Nomads <hello@kreativnomads.com.ph>".
# Defaults to Resend's shared onboarding sender, which can only deliver to your own Resend account email.
CONTACT_FROM_EMAIL=
